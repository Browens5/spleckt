# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000

# Database (local file by default; use Turso/libSQL in production)
DATABASE_URL=file:.data/spleckt.db
# DATABASE_AUTH_TOKEN=

# Cloudflare R2 (optional in local dev — falls back to .data/uploads)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=spleckt-assets
# Public bucket/CDN URL, e.g. https://assets.spleckt.com
R2_PUBLIC_URL=

# Seed admin (npm run db:seed)
ADMIN_EMAIL=admin@spleckt.com
ADMIN_PASSWORD=changeme123
ADMIN_NAME=Spleckt Admin
