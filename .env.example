# App URLs — prefer the canonical www host users land on
NEXT_PUBLIC_APP_URL=https://www.spleckt.com
BETTER_AUTH_URL=https://www.spleckt.com
# The browser auth client uses the current page origin (not this URL) so cookies stick.

# Generate locally with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-long-random-string

# Turso (preferred names)
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=

# Legacy aliases also supported:
# DATABASE_URL=
# DATABASE_AUTH_TOKEN=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=spleckt-assets
R2_PUBLIC_URL=

# Seed admin (npm run db:seed)
ADMIN_EMAIL=admin@spleckt.com
ADMIN_PASSWORD=changeme123
ADMIN_NAME=Spleckt Admin
